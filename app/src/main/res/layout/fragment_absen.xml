<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- MINIMAL PALM GREEN HEADER (CLEAN & BRIEF) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_header_gradient"
                android:clipChildren="true">

                <LinearLayout
                    android:id="@+id/layoutHeaderContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingTop="48dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="50dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Absensi Pelatihan"
                        android:textColor="@color/white"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Presensi kehadiran kelas hari ini"
                        android:textColor="#D1FAE5"
                        android:textSize="13sp" />

                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- OVERLAPPING CONTENT CONTAINER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-26dp"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="36dp">

                <!-- MODERN SEGMENTED TAB SWITCHER (USING TEXTVIEWS TO PREVENT TINT COLLISION) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_tab_container"
                    android:elevation="2dp"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/tabScan"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_tab_active"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="Scan Kamera"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tabManual"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="Input Manual"
                        android:textColor="@color/text_muted"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- SCANNER / MANUAL CARD -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardBackgroundColor="@color/card_bg"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/card_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- SCAN CONTAINER WITH DASHED BORDER -->
                        <LinearLayout
                            android:id="@+id/layoutScanBox"
                            android:layout_width="match_parent"
                            android:layout_height="220dp"
                            android:background="@drawable/bg_dashed_box"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <FrameLayout
                                android:layout_width="64dp"
                                android:layout_height="64dp"
                                android:background="@drawable/bg_circle_mint">

                                <ImageView
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_camera"
                                    app:tint="@color/header_green_dark" />
                            </FrameLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnScanQr"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:layout_marginTop="16dp"
                                android:backgroundTint="@color/header_green_dark"
                                android:paddingStart="24dp"
                                android:paddingEnd="24dp"
                                android:text="Aktifkan Kamera"
                                android:textAllCaps="false"
                                android:textColor="@color/white"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                app:cornerRadius="12dp"
                                app:elevation="2dp" />
                        </LinearLayout>

                        <!-- MANUAL INPUT CONTAINER -->
                        <LinearLayout
                            android:id="@+id/layoutManualBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Masukkan Token QR Absensi"
                                android:textColor="@color/forest_dark"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Ketik kode token presensi dari Trainer"
                                android:textColor="@color/text_muted"
                                android:textSize="12sp" />

                            <EditText
                                android:id="@+id/etManualQr"
                                android:layout_width="match_parent"
                                android:layout_height="50dp"
                                android:layout_marginTop="14dp"
                                android:background="@drawable/bg_action_pill"
                                android:hint="Contoh: TRN-2026-XYZ"
                                android:textColorHint="#94A3B8"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:textColor="@color/text_slate"
                                android:textSize="14sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnSubmitManual"
                                android:layout_width="match_parent"
                                android:layout_height="50dp"
                                android:layout_marginTop="14dp"
                                android:backgroundTint="@color/header_green_dark"
                                android:text="Kirim Absensi"
                                android:textAllCaps="false"
                                android:textColor="@color/white"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                app:cornerRadius="12dp"
                                app:elevation="2dp" />
                        </LinearLayout>

                        

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- SECTION: RIWAYAT ABSENSI -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="Riwayat Absensi"
                    android:textColor="@color/forest_dark"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvAttendances"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

                <TextView
                    android:id="@+id/tvEmptyAttendances"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="16dp"
                    android:text="Belum ada riwayat presensi."
                    android:textColor="@color/text_muted"
                    android:visibility="gone" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
