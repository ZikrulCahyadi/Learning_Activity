<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- PALM GREEN GRADIENT HEADER -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_header_gradient"
                android:clipChildren="true">

                <!-- DECORATIVE PALM LEAF SILHOUETTE (FULL-WIDTH EDGE-TO-EDGE, MATCH_CONSTRAINT NEVER EXPANDS HEADER) -->
                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:alpha="1.0"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_palm_frond"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- MAIN HEADER CONTENT -->
                <LinearLayout
                    android:id="@+id/layoutHeaderContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="48dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="56dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <!-- TOP BAR: LOGO & PROFILE AVATAR -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp">

                        <!-- LOGO FIRST RESOURCES (NO RADIUS, PROMINENT SIZE) -->
                        <FrameLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:background="@drawable/bg_logo_container"
                            android:elevation="4dp"
                            android:padding="3dp">

                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="wrap_content"
                                android:adjustViewBounds="true"
                                android:contentDescription="First Resources Logo"
                                android:src="@drawable/logo" />
                        </FrameLayout>

                        <!-- PROFILE AVATAR ICON BUTTON -->
                        <FrameLayout
                            android:id="@+id/btnHeaderProfile"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:background="@drawable/bg_avatar_circle"
                            android:clickable="true"
                            android:elevation="4dp"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_person"
                                app:tint="@color/header_green_dark" />
                        </FrameLayout>
                    </RelativeLayout>

                    <!-- GREETING & NAME -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Selamat datang,"
                        android:textColor="#E2E8F0"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvPesertaName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="Test Peserta"
                        android:textColor="@color/white"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <!-- BADGE: ACTIVE TOPIC / PROGRAM -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_pill_badge"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="6dp">

                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/dot_lime" />

                        <TextView
                            android:id="@+id/tvProgramBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="High Impact Communication"
                            android:textColor="@color/accent_lime"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- OVERLAPPING CARDS CONTAINER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-28dp"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="36dp">

                <!-- CARD 1: ABSENSI HARI INI -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAbsensi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/card_bg"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/card_border"
                    app:strokeWidth="1dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:layout_toStartOf="@id/btnScanQrAction"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/bg_circle_mint">

                                <ImageView
                                    android:layout_width="26dp"
                                    android:layout_height="26dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_check_circle"
                                    app:tint="@color/forest_mid" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Absensi Hari Ini"
                                    android:textColor="@color/text_muted"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvAttendanceStatus"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="Belum Absen"
                                    android:textColor="@color/forest_dark"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- SCAN QR BUTTON -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnScanQrAction"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:backgroundTint="@color/coral_red"
                            android:elevation="3dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:text="Scan QR"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:cornerRadius="12dp"
                            app:icon="@drawable/ic_qr_code"
                            app:iconGravity="textStart"
                            app:iconSize="18dp"
                            app:iconTint="@color/white" />

                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- CARD 2: TUGAS MENUNGGU -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardTugas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/card_bg"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/card_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/bg_box_amber">

                                <ImageView
                                    android:layout_width="26dp"
                                    android:layout_height="26dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_assignment"
                                    app:tint="@color/amber_text" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Tugas Menunggu"
                                    android:textColor="@color/text_muted"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="bottom"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/tvPendingTasksCount"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="0"
                                        android:textColor="@color/forest_dark"
                                        android:textSize="22sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="6dp"
                                        android:layout_marginBottom="2dp"
                                        android:text="tugas"
                                        android:textColor="@color/text_slate"
                                        android:textSize="13sp"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>

                        <!-- ACTION PILL: LIHAT SEMUA TUGAS -->
                        <LinearLayout
                            android:id="@+id/btnViewTasks"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="16dp"
                            android:background="@drawable/bg_action_pill"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_assignment"
                                app:tint="@color/forest_mid" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:text="Lihat Semua Tugas"
                                android:textColor="@color/forest_dark"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_chevron_right"
                                app:tint="@color/text_light_slate" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- CARD 3: EVALUASI MENUNGGU -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardEvaluasi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/card_bg"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/card_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/bg_box_blue">

                                <ImageView
                                    android:layout_width="26dp"
                                    android:layout_height="26dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_star"
                                    app:tint="@color/blue_icon" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Evaluasi Menunggu"
                                    android:textColor="@color/text_muted"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="bottom"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/tvPendingEvalsCount"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="0"
                                        android:textColor="@color/forest_dark"
                                        android:textSize="22sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="6dp"
                                        android:layout_marginBottom="2dp"
                                        android:text="Sesi"
                                        android:textColor="@color/text_slate"
                                        android:textSize="13sp"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>

                        <!-- ACTION PILL: MULAI EVALUASI -->
                        <LinearLayout
                            android:id="@+id/btnStartEvalAction"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="16dp"
                            android:background="@drawable/bg_action_pill"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_star"
                                app:tint="@color/blue_icon" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:text="Mulai Evaluasi"
                                android:textColor="@color/forest_dark"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_chevron_right"
                                app:tint="@color/text_light_slate" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- CARD 4: JADWAL TRAINING AKTIF (IMAGE 1 REPLICA) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSchedule"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardBackgroundColor="@color/header_green_dark"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="4dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_schedule_gradient"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- HEADER JADWAL: BOOK OPEN CHECK ICON + DIVIDER + TITLE -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:src="@drawable/ic_book"
                                app:tint="@color/accent_lime" />

                            <View
                                android:layout_width="1dp"
                                android:layout_height="36dp"
                                android:layout_marginStart="14dp"
                                android:layout_marginEnd="14dp"
                                android:background="#33FFFFFF" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvScheduleHeaderTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Jadwal Pelatihan Aktif"
                                    android:textColor="#E8FCF1"
                                    android:textSize="17sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvScheduleSubtitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="Detail jadwal kelas Anda saat ini."
                                    android:textColor="#E0FFFFFF"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- DETAILS CONTAINER -->
                        <LinearLayout
                            android:id="@+id/layoutScheduleDetails"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:orientation="vertical">

                            <!-- ITEM 1: TANGGAL -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <FrameLayout
                                    android:layout_width="38dp"
                                    android:layout_height="38dp"
                                    android:background="@drawable/bg_schedule_box">

                                    <ImageView
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_calendar"
                                        app:tint="@color/accent_lime" />
                                </FrameLayout>

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="TANGGAL"
                                        android:textColor="#B3FFFFFF"
                                        android:textSize="10sp"
                                        android:letterSpacing="0.05" />

                                    <TextView
                                        android:id="@+id/tvScheduleDate"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="13 Okt 2026"
                                        android:textColor="@color/white"
                                        android:textSize="14sp"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </LinearLayout>

                            <!-- ROW 2: WAKTU & LOKASI -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:orientation="horizontal"
                                android:weightSum="2">

                                <!-- WAKTU -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <FrameLayout
                                        android:layout_width="38dp"
                                        android:layout_height="38dp"
                                        android:background="@drawable/bg_schedule_box">

                                        <ImageView
                                            android:layout_width="20dp"
                                            android:layout_height="20dp"
                                            android:layout_gravity="center"
                                            android:src="@drawable/ic_clock"
                                            app:tint="@color/accent_lime" />
                                    </FrameLayout>

                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="10dp"
                                        android:orientation="vertical">

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="WAKTU"
                                            android:textColor="#B3FFFFFF"
                                            android:textSize="10sp"
                                            android:letterSpacing="0.05" />

                                        <TextView
                                            android:id="@+id/tvScheduleTime"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="08:00 - 16:00"
                                            android:textColor="@color/white"
                                            android:textSize="13sp"
                                            android:textStyle="bold" />
                                    </LinearLayout>
                                </LinearLayout>

                                <!-- LOKASI -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <FrameLayout
                                        android:layout_width="38dp"
                                        android:layout_height="38dp"
                                        android:background="@drawable/bg_schedule_box">

                                        <ImageView
                                            android:layout_width="20dp"
                                            android:layout_height="20dp"
                                            android:layout_gravity="center"
                                            android:src="@drawable/ic_location"
                                            app:tint="@color/accent_lime" />
                                    </FrameLayout>

                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="10dp"
                                        android:orientation="vertical">

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="LOKASI"
                                            android:textColor="#B3FFFFFF"
                                            android:textSize="10sp"
                                            android:letterSpacing="0.05" />

                                        <TextView
                                            android:id="@+id/tvScheduleLocation"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="FR Academy"
                                            android:textColor="@color/white"
                                            android:textSize="13sp"
                                            android:textStyle="bold" />
                                    </LinearLayout>
                                </LinearLayout>
                            </LinearLayout>

                            <!-- ROW 3: RUANGAN & INSTRUKTUR -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:orientation="horizontal"
                                android:weightSum="2">

                                <!-- RUANGAN -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <FrameLayout
                                        android:layout_width="38dp"
                                        android:layout_height="38dp"
                                        android:background="@drawable/bg_schedule_box">

                                        <ImageView
                                            android:layout_width="20dp"
                                            android:layout_height="20dp"
                                            android:layout_gravity="center"
                                            android:src="@drawable/ic_home"
                                            app:tint="@color/accent_lime" />
                                    </FrameLayout>

                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="10dp"
                                        android:orientation="vertical">

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="RUANGAN"
                                            android:textColor="#B3FFFFFF"
                                            android:textSize="10sp"
                                            android:letterSpacing="0.05" />

                                        <TextView
                                            android:id="@+id/tvScheduleRoom"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Ruang Leadership A"
                                            android:textColor="@color/white"
                                            android:textSize="13sp"
                                            android:textStyle="bold" />
                                    </LinearLayout>
                                </LinearLayout>

                                <!-- INSTRUKTUR -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <FrameLayout
                                        android:layout_width="38dp"
                                        android:layout_height="38dp"
                                        android:background="@drawable/bg_schedule_box">

                                        <ImageView
                                            android:layout_width="20dp"
                                            android:layout_height="20dp"
                                            android:layout_gravity="center"
                                            android:src="@drawable/ic_person"
                                            app:tint="@color/accent_lime" />
                                    </FrameLayout>

                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="10dp"
                                        android:orientation="vertical">

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="INSTRUKTUR"
                                            android:textColor="#B3FFFFFF"
                                            android:textSize="10sp"
                                            android:letterSpacing="0.05" />

                                        <TextView
                                            android:id="@+id/tvScheduleTrainer"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Nama Trainer"
                                            android:textColor="@color/white"
                                            android:textSize="13sp"
                                            android:textStyle="bold" />
                                    </LinearLayout>
                                </LinearLayout>
                            </LinearLayout>

                            <!-- LMS SECTION -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="20dp"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Akses materi dan modul pelatihan silahkan cek di LMS FR Academy."
                                    android:textColor="#E0FFFFFF"
                                    android:textSize="12sp"
                                    android:lineSpacingExtra="2dp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnLms"
                                    android:layout_width="match_parent"
                                    android:layout_height="50dp"
                                    android:layout_marginTop="10dp"
                                    android:backgroundTint="@color/accent_lime"
                                    android:elevation="3dp"
                                    android:text="LMS FR Academy"
                                    android:textAllCaps="false"
                                    android:textColor="@color/header_green_dark"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    app:cornerRadius="12dp"
                                    app:icon="@drawable/ic_book"
                                    app:iconGravity="textStart"
                                    app:iconSize="20dp"
                                    app:iconTint="@color/header_green_dark" />
                            </LinearLayout>

                            <!-- MESS SECTION -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="18dp"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Butuh penginapan selama masa pelatihan? Anda dapat melihat informasi melalui portal resmi Mess FR Academy."
                                    android:textColor="#E0FFFFFF"
                                    android:textSize="12sp"
                                    android:lineSpacingExtra="2dp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnMess"
                                    android:layout_width="match_parent"
                                    android:layout_height="50dp"
                                    android:layout_marginTop="10dp"
                                    android:backgroundTint="@color/white"
                                    android:elevation="3dp"
                                    android:text="Mess FR Academy"
                                    android:textAllCaps="false"
                                    android:textColor="@color/header_green_dark"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    app:cornerRadius="12dp"
                                    app:icon="@drawable/ic_home"
                                    app:iconGravity="textStart"
                                    app:iconSize="20dp"
                                    app:iconTint="@color/header_green_dark" />
                            </LinearLayout>

                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
