<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page">

    <ScrollView
        android:id="@+id/scrollViewEval"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- PALM GREEN HEADER -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_header_gradient"
                android:clipChildren="true">

                <LinearLayout
                    android:id="@+id/layoutHeaderContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingTop="48dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="50dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Evaluasi Pelatihan"
                        android:textColor="@color/white"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSessionName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Materi: High Impact Communication"
                        android:textColor="#D1FAE5"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTrainerName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Trainer: -"
                        android:textColor="#A7F3D0"
                        android:textSize="12.5sp" />

                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- FORM CARDS CONTAINER (OVERLAPPING) -->
            <LinearLayout
                android:id="@+id/containerContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-26dp"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="100dp">

                <!-- LOADING SPINNER -->
                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="32dp"
                    android:indeterminateTint="@color/header_green_dark"
                    android:visibility="gone" />

                <!-- EMPTY STATE -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/layoutEmptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/card_bg"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/card_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="32dp">

                        <ImageView
                            android:id="@+id/ivEmptyIcon"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:src="@drawable/ic_check_circle"
                            app:tint="@color/accent_green" />

                        <TextView
                            android:id="@+id/tvEmptyTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="Belum Ada Evaluasi"
                            android:textColor="@color/text_slate"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvEmptySubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:text="Saat ini tidak ada sesi pelatihan yang memerlukan evaluasi Anda."
                            android:textColor="@color/text_muted"
                            android:textSize="12.5sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- FORM CONTENT -->
                <LinearLayout
                    android:id="@+id/layoutFormContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- DYNAMIC CATEGORIES & QUESTIONS CONTAINER -->
                    <LinearLayout
                        android:id="@+id/layoutQuestionsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <!-- EXPLANATION FOR D / E (DYNAMICALLY SHOWN) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardExplanationDE"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:visibility="gone"
                        app:cardBackgroundColor="#FFFBEB"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="1dp"
                        app:strokeColor="#FED7AA"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Penjelasan Nilai D / E"
                                android:textColor="#9A3412"
                                android:textSize="13.5sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Wajib diisi karena terdapat pilihan jawaban bernilai D atau E."
                                android:textColor="#B45309"
                                android:textSize="11.5sp" />

                            <EditText
                                android:id="@+id/etExplanationDE"
                                android:layout_width="match_parent"
                                android:layout_height="90dp"
                                android:layout_marginTop="10dp"
                                android:background="@drawable/bg_action_pill"
                                android:gravity="top|start"
                                android:hint="Berikan penjelasan Anda mengenai nilai D / E..."
                                android:padding="12dp"
                                android:textColor="@color/text_slate"
                                android:textColorHint="#94A3B8"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- KESAN PESAN -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardKesanPesan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        app:cardBackgroundColor="@color/card_bg"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp"
                        app:strokeColor="@color/card_border"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Kesan &amp; Pesan (Wajib)"
                                android:textColor="@color/header_green_dark"
                                android:textSize="13.5sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Tuliskan kesan dan pesan Anda selama mengikuti pelatihan ini."
                                android:textColor="@color/text_muted"
                                android:textSize="11.5sp" />

                            <EditText
                                android:id="@+id/etKesanPesan"
                                android:layout_width="match_parent"
                                android:layout_height="100dp"
                                android:layout_marginTop="10dp"
                                android:background="@drawable/bg_action_pill"
                                android:gravity="top|start"
                                android:hint="Tuliskan kesan dan pesan Anda selama mengikuti pelatihan ini..."
                                android:padding="12dp"
                                android:textColor="@color/text_slate"
                                android:textColorHint="#94A3B8"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- SUBMIT BUTTON -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSubmitEval"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:backgroundTint="@color/header_green_dark"
                        android:text="Kirim Evaluasi"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:cornerRadius="14dp"
                        app:elevation="2dp" />

                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
